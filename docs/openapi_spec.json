{
  "openapi": "3.1.0",
  "info": {
    "title": "VistoBueno API",
    "description": "API de validación automática de formato de tesis — UNT FECyC",
    "version": "1.2.0"
  },
  "paths": {
    "/validar": {
      "post": {
        "summary": "Validar formato de tesis",
        "description": "Recibe un archivo DOCX de tesis y devuelve un reporte de validación contra las reglas de formato de la Universidad Nacional de Trujillo.",
        "operationId": "validar_validar_post",
        "parameters": [
          {
            "name": "incluir_prompts_ia",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Incluir la sección 'Cómo preguntar a una IA' en la respuesta",
              "default": true,
              "title": "Incluir Prompts Ia"
            },
            "description": "Incluir la sección 'Cómo preguntar a una IA' en la respuesta"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_validar_validar_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidarResponse"
                }
              }
            }
          },
          "400": {
            "description": "Sin archivo en la solicitud"
          },
          "413": {
            "description": "Archivo excede el tamaño máximo (10 MB)"
          },
          "415": {
            "description": "Tipo de archivo no soportado"
          },
          "422": {
            "description": "Archivo corrupto, no es DOCX válido o correo inválido"
          },
          "500": {
            "description": "Error interno del validador"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_validar_validar_post": {
        "properties": {
          "archivo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Archivo",
            "description": "Archivo .docx a validar"
          },
          "correo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo",
            "description": "Correo electrónico del estudiante (opcional). Se usará para notificar resultados cuando el envío esté habilitado."
          }
        },
        "type": "object",
        "required": [
          "archivo"
        ],
        "title": "Body_validar_validar_post"
      },
      "MetadatosValidacion": {
        "properties": {
          "archivo_nombre": {
            "type": "string",
            "title": "Archivo Nombre",
            "description": "Nombre original del archivo subido"
          },
          "archivo_tamano_bytes": {
            "type": "integer",
            "title": "Archivo Tamano Bytes",
            "description": "Tamaño en bytes del archivo"
          },
          "reglas_evaluadas": {
            "type": "integer",
            "title": "Reglas Evaluadas",
            "description": "Cantidad de reglas ejecutadas"
          },
          "version_esquema": {
            "type": "string",
            "title": "Version Esquema",
            "description": "Versión del esquema YAML de reglas"
          }
        },
        "type": "object",
        "required": [
          "archivo_nombre",
          "archivo_tamano_bytes",
          "reglas_evaluadas",
          "version_esquema"
        ],
        "title": "MetadatosValidacion",
        "description": "Metadatos del procesamiento, agregados por la capa API.\n\nEstos campos no existen en el motor interno; se agregan aquí\npara dar contexto al frontend sobre el archivo procesado."
      },
      "PromptIA": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id",
            "description": "ID de la regla fallida"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Prompt completo en español"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "prompt"
        ],
        "title": "PromptIA",
        "description": "Bloque 'cómo preguntar a una IA' para una regla fallida.\n\nContiene un prompt listo para copiar y pegar en un LLM externo,\ncon el contexto de la regla incumplida."
      },
      "ResultadoReglaAPI": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id",
            "description": "Identificador único de la regla"
          },
          "paso": {
            "type": "boolean",
            "title": "Paso",
            "description": "True si la regla se cumplió"
          },
          "severidad": {
            "$ref": "#/components/schemas/SeveridadAPI",
            "description": "error o warning"
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje",
            "description": "Descripción de la regla en lenguaje natural"
          },
          "esperado": {
            "type": "string",
            "title": "Esperado",
            "description": "Valor esperado según el reglamento",
            "default": ""
          },
          "encontrado": {
            "type": "string",
            "title": "Encontrado",
            "description": "Lo que encontró el validador",
            "default": ""
          },
          "ubicacion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ubicacion",
            "description": "Referencia al documento del reglamento"
          },
          "fuente": {
            "type": "string",
            "title": "Fuente",
            "description": "Archivo fuente del que se extrajo la regla",
            "default": ""
          },
          "cita": {
            "type": "string",
            "title": "Cita",
            "description": "Cita textual del reglamento",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "paso",
          "severidad",
          "mensaje"
        ],
        "title": "ResultadoReglaAPI",
        "description": "Resultado de una regla individual en la respuesta de la API.\n\nEquivalente al `RuleResult` interno del motor, pero con campos\nrenombrados a español y en formato snake_case para JSON.",
        "examples": [
          {
            "cita": "\"Tamaño A4/papel (210x297 cm)\"",
            "encontrado": "cumple",
            "esperado": "210 x 297 mm",
            "fuente": "MANUAL REVISADO TERCERA VERSION OBSERVACIONES 11-07-2025.docx",
            "mensaje": "El tamaño del papel debe ser A4",
            "paso": true,
            "rule_id": "papel_tamano",
            "severidad": "error",
            "ubicacion": "Sección \"Formato general\" (párr. 124-125)"
          }
        ]
      },
      "ResumenValidacion": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total de reglas evaluadas"
          },
          "fallidos_error": {
            "type": "integer",
            "title": "Fallidos Error",
            "description": "Reglas con severidad error que no pasaron"
          },
          "fallidos_warning": {
            "type": "integer",
            "title": "Fallidos Warning",
            "description": "Reglas con severidad warning que no pasaron"
          }
        },
        "type": "object",
        "required": [
          "total",
          "fallidos_error",
          "fallidos_warning"
        ],
        "title": "ResumenValidacion",
        "description": "Resumen cuantitativo de la validación."
      },
      "SeveridadAPI": {
        "type": "string",
        "enum": [
          "error",
          "warning"
        ],
        "title": "SeveridadAPI",
        "description": "Severidad de una regla de validación."
      },
      "ValidarResponse": {
        "properties": {
          "semaforo": {
            "type": "string",
            "title": "Semaforo",
            "description": "\"verde\" si todas las reglas error pasan, \"rojo\" si alguna falla"
          },
          "resumen": {
            "$ref": "#/components/schemas/ResumenValidacion",
            "description": "Resumen cuantitativo"
          },
          "resultados": {
            "items": {
              "$ref": "#/components/schemas/ResultadoReglaAPI"
            },
            "type": "array",
            "title": "Resultados",
            "description": "Resultados por regla"
          },
          "como_preguntar_a_una_ia": {
            "items": {
              "$ref": "#/components/schemas/PromptIA"
            },
            "type": "array",
            "title": "Como Preguntar A Una Ia",
            "description": "Bloques de prompts IA para reglas fallidas"
          },
          "metadatos": {
            "$ref": "#/components/schemas/MetadatosValidacion",
            "description": "Metadatos del procesamiento"
          }
        },
        "type": "object",
        "required": [
          "semaforo",
          "resumen",
          "resultados",
          "metadatos"
        ],
        "title": "ValidarResponse",
        "description": "Respuesta completa del endpoint POST /validar.\n\nAgrupa el semáforo, el resumen, los resultados individuales por regla,\nlos prompts de IA y los metadatos del procesamiento.",
        "examples": [
          {
            "como_preguntar_a_una_ia": [],
            "metadatos": {
              "archivo_nombre": "mi_tesis.docx",
              "archivo_tamano_bytes": 123456,
              "reglas_evaluadas": 31,
              "version_esquema": "2026-09-01"
            },
            "resultados": [
              {
                "cita": "\"Tamaño A4/papel (210x297 cm)\"",
                "encontrado": "cumple",
                "esperado": "210 x 297 mm",
                "fuente": "MANUAL REVISADO TERCERA VERSION OBSERVACIONES 11-07-2025.docx",
                "mensaje": "El tamaño del papel debe ser A4",
                "paso": true,
                "rule_id": "papel_tamano",
                "severidad": "error",
                "ubicacion": "Sección \"Formato general\" (párr. 124-125)"
              }
            ],
            "resumen": {
              "fallidos_error": 0,
              "fallidos_warning": 2,
              "total": 31
            },
            "semaforo": "verde"
          }
        ]
      }
    }
  }
}
